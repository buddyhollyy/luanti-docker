#!/usr/bin/env python3
"""Back up the server world to BACKUP_DIR/world-YYYY-MM-DD.tar.gz, safe
while the server runs. Keeps the newest KEEP_DAILY backups plus KEEP_WEEKLY
older Sunday ones. The backup service in compose.yml runs it every night at
BACKUP_TIME; run it by hand with: sudo ./backup-world
Settings come from the environment, then .env, then the defaults below."""
import datetime, os, re, shutil, sqlite3, sys, tarfile, tempfile, time

here = os.path.dirname(os.path.realpath(__file__))
dotenv = {}
try:
    for line in open(os.path.join(here, ".env")):
        k, _, v = line.strip().partition("=")
        if k and not k.startswith("#"):
            dotenv[k] = v
except OSError:
    pass

def setting(name, default):
    return os.environ.get(name) or dotenv.get(name) or default

WORLD = setting("WORLD", os.path.join(here, "data/.minetest/worlds/world"))
DIR = os.path.join(here, setting("BACKUP_DIR", "backups"))
DAILY = max(1, int(setting("KEEP_DAILY", "7")))
WEEKLY = max(0, int(setting("KEEP_WEEKLY", "4")))
AT = setting("BACKUP_TIME", "04:00")
NAME = re.compile(r"^world-(\d{4}-\d{2}-\d{2})\.tar\.gz$")
OWNER = os.stat(os.path.realpath(__file__))  # backups belong to whoever owns this file

def backup():
    if not os.path.isfile(os.path.join(WORLD, "world.mt")):
        sys.exit("No world found at " + WORLD)
    os.makedirs(DIR, exist_ok=True)
    with tempfile.TemporaryDirectory() as tmp:
        dst = os.path.join(tmp, "world")
        shutil.copytree(WORLD, dst, ignore=shutil.ignore_patterns(
            "*.sqlite", "*.sqlite-journal", "*.sqlite-wal", "*.sqlite-shm"))
        # Consistent copies of the databases while the server keeps writing.
        for f in sorted(os.listdir(WORLD)):
            if f.endswith(".sqlite"):
                src = sqlite3.connect("file:%s?mode=ro" % os.path.join(WORLD, f), uri=True, timeout=30)
                out = sqlite3.connect(os.path.join(dst, f))
                src.backup(out)
                out.close(); src.close()
        part = os.path.join(DIR, ".partial.tar.gz")
        with tarfile.open(part, "w:gz") as t:
            t.add(dst, "world")
    final = os.path.join(DIR, "world-%s.tar.gz" % datetime.date.today())
    for p in (DIR, part):
        os.chown(p, OWNER.st_uid, OWNER.st_gid)
    os.chmod(part, 0o644)
    os.replace(part, final)
    # Keep the newest DAILY, then the newest WEEKLY Sundays older than those.
    names = sorted((n for n in os.listdir(DIR) if NAME.match(n)), reverse=True)
    weekly = 0
    for i, n in enumerate(names):
        if i < DAILY:
            continue
        day = datetime.date.fromisoformat(NAME.match(n).group(1))
        if day.isoweekday() == 7 and weekly < WEEKLY:
            weekly += 1
            continue
        os.remove(os.path.join(DIR, n))
    kept = sum(1 for n in os.listdir(DIR) if NAME.match(n))
    print("%s Saved %s (%.0f MB), %d backups kept" % (time.strftime("%F %T"),
          final, os.path.getsize(final) / 1e6, kept), flush=True)

def nightly():
    h, m = (int(x) for x in AT.split(":"))
    print("Backing up every night at %02d:%02d (%s), keeping %d daily + %d weekly"
          % (h, m, time.strftime("%Z"), DAILY, WEEKLY), flush=True)
    while True:
        now = datetime.datetime.now()
        nxt = now.replace(hour=h, minute=m, second=0, microsecond=0)
        if nxt <= now:
            nxt += datetime.timedelta(days=1)
        time.sleep((nxt - now).total_seconds())
        try:
            backup()
        except (OSError, sqlite3.Error, SystemExit) as e:
            print("%s Backup failed: %s" % (time.strftime("%F %T"), e), flush=True)
        time.sleep(61)

if __name__ == "__main__":
    nightly() if sys.argv[1:] == ["--nightly"] else backup()

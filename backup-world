#!/bin/sh
# Nightly backup of the server world to BACKUP_DIR/world-YYYY-MM-DD.tar.gz.
# Safe while the server runs. Keeps the newest KEEP_DAILY backups plus
# KEEP_WEEKLY older Sunday ones; set all three in .env. Run by root from cron:
#   0 4 * * * root /home/<you>/docker/luanti/backup-world
set -eu
[ "$(id -u)" = 0 ] || { echo "Run it with sudo: sudo $0"; exit 1; }
cd "$(dirname "$(realpath "$0")")"

env_get() { sed -n "s/^$1=//p" .env 2>/dev/null | tail -1; }
dir=$(env_get BACKUP_DIR); dir=${dir:-./backups}
daily=$(env_get KEEP_DAILY); daily=${daily:-7}
weekly=$(env_get KEEP_WEEKLY); weekly=${weekly:-4}
case "$daily$weekly" in *[!0-9]*|'') echo "KEEP_DAILY and KEEP_WEEKLY must be numbers"; exit 1 ;; esac
[ "$daily" -ge 1 ] || daily=1
owner=$(stat -c %U:%G .)

src=data/.minetest/worlds/world
[ -f "$src/world.mt" ] || { echo "No world found at $src"; exit 1; }
mkdir -p "$dir" && chown "$owner" "$dir"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
cp -a "$src" "$tmp/world"
rm -f "$tmp"/world/*.sqlite-journal "$tmp"/world/*.sqlite-wal "$tmp"/world/*.sqlite-shm
# Consistent copies of the databases while the server keeps writing.
for db in "$src"/*.sqlite; do
  sqlite3 "$db" ".backup '$tmp/world/${db##*/}'"
done
out=$dir/world-$(date +%F).tar.gz
tar -czf "$dir/.partial.tar.gz" -C "$tmp" world
chown "$owner" "$dir/.partial.tar.gz"
mv "$dir/.partial.tar.gz" "$out"

# Keep the newest $daily, then the newest $weekly Sundays older than those.
n=0; w=0
for f in $(ls -1 "$dir" | grep -E '^world-[0-9]{4}-[0-9]{2}-[0-9]{2}\.tar\.gz$' | sort -r); do
  n=$((n + 1))
  [ "$n" -le "$daily" ] && continue
  if [ "$(date -d "$(echo "$f" | cut -c7-16)" +%u)" = 7 ] && [ "$w" -lt "$weekly" ]
  then w=$((w + 1)); continue; fi
  rm -f "$dir/$f"
done
echo "Saved $out ($(du -h "$out" | cut -f1)), $(ls -1 "$dir" | grep -c '^world-.*\.tar\.gz$') backups kept"
